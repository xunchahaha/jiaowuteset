<import src="../common/ui.wxml" />

<view class="page {{orderOpen && scanned && courses.length ? '' : 'no-footer'}}">
  <template is="steps" data="{{step: scanned ? 2 : 1, available}}" />

  <view wx:if="{{runningTaskId}}" class="running" bind:tap="onGoRunning">
    <view class="running-dot"></view>
    <text class="running-text">有任务正在刷课，点这里看进度</text>
    <t-icon name="chevron-right" size="32rpx" />
  </view>

  <!-- 下单关闭：不再读课程 / 选课，已有任务从上面的横幅或订单页进 -->
  <view wx:if="{{!orderOpen}}" class="card state">
    <t-empty icon="info-circle" description="{{closedText}}" />
    <t-button theme="primary" size="medium" bind:tap="onGoMe">查看我的订单</t-button>
  </view>

  <block wx:else>
  <!-- ① 学习通账号 -->
  <view wx:if="{{scanned && !editingAccount}}" class="card account-row">
    <view class="account-badge"><t-icon name="check" size="28rpx" /></view>
    <view class="account-main">
      <view class="account-title">学习通 {{maskedUser}}</view>
      <view class="account-desc">共 {{courses.length}} 门进行中的课程</view>
    </view>
    <text class="link" bind:tap="onScan">{{scanning ? '读取中' : '刷新'}}</text>
    <text class="link gap" bind:tap="onEditAccount">换账号</text>
  </view>

  <view wx:else class="card">
    <view class="card-head">
      <view>
        <view class="card-title">登录学习通</view>
        <view class="card-desc">填写超星学习通的账号，不是教务系统账号</view>
      </view>
      <text wx:if="{{scanned}}" class="link" bind:tap="onCollapseAccount">收起</text>
    </view>

    <view class="field">
      <t-input borderless label="手机号" placeholder="学习通登录手机号"
               value="{{username}}" disabled="{{scanning}}" bind:change="onUsername" />
    </view>
    <view class="field">
      <t-input borderless label="密码" type="{{showPassword ? 'text' : 'password'}}" placeholder="学习通登录密码"
               value="{{password}}" disabled="{{scanning}}" bind:change="onPassword">
        <view slot="suffix-icon" class="eye" catch:tap="onTogglePassword">
          <t-icon name="{{showPassword ? 'browse' : 'browse-off'}}" size="36rpx" />
        </view>
      </t-input>
    </view>
    <view class="remember">
      <view class="remember-text">
        <t-icon name="lock-on" size="28rpx" />
        <text>记住密码（只保存在这台手机上）</text>
      </view>
      <t-switch size="small" value="{{remember}}" bind:change="onToggleRemember" />
    </view>

    <t-button theme="primary" block size="large" loading="{{scanning}}" disabled="{{scanning}}" bind:tap="onScan">
      {{scanning ? '正在读取课程' : '登录并读取课程'}}
    </t-button>

    <view wx:if="{{scanning}}" class="scan">
      <view class="scan-track"><view class="scan-runner"></view></view>
      <view class="scan-text">{{scanText}}</view>
      <view wx:if="{{scanSoft}}" class="scan-soft">课程多时会慢一些，请不要退出或重复点击</view>
    </view>

    <view wx:if="{{scanError}}" class="alert danger">
      <t-icon name="error-circle" size="32rpx" />
      <text class="alert-text">{{scanError}}</text>
    </view>

    <view wx:if="{{!scanned && draftCount && !scanning}}" class="restore" bind:tap="onRestoreDraft">
      <t-icon name="time" size="28rpx" />
      <text>恢复上次选的 {{draftCount}} 门课</text>
    </view>
  </view>

  <!-- ② 选课 -->
  <block wx:if="{{scanned}}">
    <view class="section-head">
      <view class="section-title">选择要刷的课程</view>
      <text wx:if="{{courses.length}}" class="link" bind:tap="onToggleAll">{{allSelected ? '取消全选' : '全选'}}</text>
    </view>

    <view wx:if="{{!courses.length}}" class="card state">
      <t-empty icon="info-circle" description="这个账号下没有进行中的课程" />
    </view>

    <view wx:for="{{courses}}" wx:key="key"
          class="course {{selected[item.key] ? 'on' : ''}}" data-key="{{item.key}}" bind:tap="onToggleCourse">
      <view class="check {{selected[item.key] ? 'on' : ''}}">
        <t-icon wx:if="{{selected[item.key]}}" name="check" size="26rpx" />
      </view>
      <view class="course-main">
        <view class="course-title">{{item.title}}</view>
        <view class="course-meta">
          <text>{{item.teacher || '未知教师'}}</text>
          <text wx:if="{{item.chapterCount}}"> · {{item.chapterCount}} 个章节</text>
        </view>
        <view wx:if="{{item.needUnlock}}" class="tag tone-warn course-tag">有答题解锁章节，需开自动答题</view>
      </view>
    </view>
  </block>
  </block>

  <view wx:if="{{orderOpen && scanned && courses.length}}" class="footer">
    <view class="footer-info">
      <view class="footer-main">已选<text class="em">{{selectedCount}}</text>门</view>
      <view class="footer-sub">{{selectedCount ? '每门 1 次，下一步确认答题与支付' : '点课程即可选择'}}</view>
    </view>
    <view class="footer-btn">
      <t-button theme="primary" size="large" block disabled="{{!selectedCount}}" bind:tap="onNext">下一步</t-button>
    </view>
  </view>
</view>
