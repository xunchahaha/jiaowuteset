@import "../study.wxss";

/* 活动页用暖色调做出「助力」的氛围，和刷课主流程的蓝色区分开 */
page {
  --gift: #c2621c;
  --gift-deep: #8f4214;
  --gift-soft: #fbf3ea;
  --gift-line: #f1dcc4;
  background: var(--gift-soft);
}

/* ---------- 主卡 ---------- */
.hero {
  position: relative;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 28rpx;
  color: #ffffff;
  background: #c2621c;
  box-shadow: 0 16rpx 40rpx rgba(143, 66, 20, 0.22);
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.hero-eyebrow {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 18rpx;
}

.hero-title { font-size: 40rpx; font-weight: 700; line-height: 1.35; }
.hero-desc { font-size: 25rpx; line-height: 1.6; margin-top: 12rpx; opacity: 0.92; }

/* 助力位 */
.slots { display: flex; justify-content: center; margin: 40rpx 0 32rpx; }
.slot { display: flex; flex-direction: column; align-items: center; width: 180rpx; }

.slot-circle {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx dashed rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.slot-q { font-size: 44rpx; font-weight: 700; opacity: 0.8; }
.slot.on .slot-circle { border: none; background: #ffffff; color: var(--gift); animation: pop 0.4s ease-out; }
.slot-label { font-size: 24rpx; margin-top: 14rpx; }
.slot-reward { font-size: 22rpx; opacity: 0.8; margin-top: 4rpx; }

@keyframes pop {
  0% { transform: scale(0.6); }
  70% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

/* 进度 */
.meter { margin-bottom: 32rpx; }
.meter-text { display: flex; justify-content: space-between; align-items: baseline; font-size: 24rpx; }
.meter-num { font-size: 36rpx; font-weight: 700; margin: 0 4rpx; }
.meter-hint { opacity: 0.85; }
.meter-track { height: 14rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.25); margin-top: 12rpx; overflow: hidden; }
.meter-fill { height: 100%; border-radius: 999rpx; background: #ffe2b8; transition: width 0.5s ease; }

/* 分享按钮（原生 button 才能 open-type="share"） */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--gift-deep);
  font-size: 32rpx;
  font-weight: 700;
  padding: 0;
  margin: 0;
  line-height: 96rpx;
}

.share-btn::after { border: none; }
.share-btn text { margin-left: 12rpx; }
.share-btn.done { background: #ffe2b8; }
.share-btn.off { background: rgba(255, 255, 255, 0.3); color: #ffffff; font-weight: 500; font-size: 28rpx; }

/* 好友帮忙的三步 */
.help-steps { display: flex; align-items: center; justify-content: space-between; margin-top: 32rpx; }
.help-step { display: flex; flex-direction: column; align-items: center; font-size: 22rpx; flex: 1; }

.help-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ffffff;
  color: var(--gift);
  font-weight: 700;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.help-arrow { font-size: 32rpx; opacity: 0.7; margin-bottom: 30rpx; }

/* visit 模式 */
.cta-wrap { margin-bottom: 28rpx; }
.cta { --td-button-primary-bg-color: var(--gift); --td-button-primary-border-color: var(--gift); --td-button-primary-active-bg-color: var(--gift-deep); --td-button-primary-active-border-color: var(--gift-deep); }
.cta-note { font-size: 22rpx; color: var(--muted); text-align: center; margin-top: 16rpx; }

.visit-result { display: flex; align-items: center; color: var(--gift-deep); border-color: var(--gift-line); }
.visit-result-text { flex: 1; margin-left: 16rpx; font-size: 27rpx; line-height: 1.55; }

.me-too { display: flex; align-items: center; border-color: var(--gift-line); }
.me-too-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--gift-soft);
  color: var(--gift);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.me-too-main { flex: 1; }
.me-too-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.me-too-desc { font-size: 23rpx; color: var(--muted); margin-top: 4rpx; }

/* 好友列表 */
.card { border-color: var(--gift-line); }
.list { padding: 8rpx 24rpx; }
.helper { display: flex; align-items: center; padding: 20rpx 0; }
.helper + .helper { border-top: 1rpx solid var(--line); }

.helper-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.helper-main { flex: 1; min-width: 0; }
.helper-name { font-size: 27rpx; color: var(--ink); }
.helper-time { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }

.empty-helpers { text-align: center; padding: 40rpx 32rpx; }
.empty-title { font-size: 28rpx; color: var(--ink); font-weight: 600; }
.empty-desc { font-size: 24rpx; color: var(--muted); margin-top: 10rpx; line-height: 1.6; }

/* 怎么领 */
.how { padding: 12rpx 24rpx; }
.how-step { display: flex; align-items: center; padding: 18rpx 0; }

.how-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--gift-soft);
  color: var(--gift);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.how-text { font-size: 26rpx; color: var(--ink); line-height: 1.5; }

.rules { font-size: 24rpx; color: var(--muted); line-height: 1.7; }
.rule + .rule { margin-top: 8rpx; }
