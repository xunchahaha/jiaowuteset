@import "../study.wxss";

/* 课程清单 */
.line { display: flex; align-items: center; padding: 10rpx 0; }
.line-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--brand); margin-right: 16rpx; flex-shrink: 0; }

.line-title {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  font-size: 27rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more { display: flex; align-items: center; justify-content: center; padding: 12rpx 0 4rpx; font-size: 24rpx; color: var(--brand); }

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 26rpx;
}

.kv-k { color: var(--muted); }
.kv-v { color: var(--ink); }

.pwd { margin-top: 20rpx; }
.pwd-tip { font-size: 23rpx; color: var(--warn); margin-bottom: 12rpx; }

/* 选项 */
.opt { display: flex; align-items: center; }
.opt-main { flex: 1; margin-right: 24rpx; }
.opt-title { display: flex; align-items: center; font-size: 28rpx; font-weight: 600; color: var(--ink); }
.opt-tag { margin-left: 12rpx; font-weight: 400; }
.opt-desc { font-size: 23rpx; color: var(--muted); margin-top: 6rpx; line-height: 1.5; }
.opt-note { font-size: 23rpx; color: var(--warn); margin-top: 6rpx; line-height: 1.5; }
.opt-sep { height: 1rpx; background: var(--line); margin: 24rpx 0; }

/* 账单 */
.bill { margin-top: 16rpx; }
.bill-row { display: flex; justify-content: space-between; font-size: 26rpx; color: var(--ink); padding: 8rpx 0; }
.bill-row.danger { color: var(--danger); }
.bill-row.muted { color: var(--muted); font-size: 24rpx; }

.bill-row.total {
  margin-top: 8rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--line);
  font-weight: 600;
}

/* 套餐 */
.pick-title { font-size: 24rpx; color: var(--muted); margin: 28rpx 0 14rpx; }
.plans { display: flex; margin: 0 -8rpx; }

.plan {
  flex: 1;
  margin: 0 8rpx;
  padding: 22rpx 8rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  text-align: center;
}

.plan.on { border-color: var(--brand); background: var(--td-brand-color-light); }
.plan.off { opacity: 0.45; }
.plan-credits { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.plan-price { font-size: 24rpx; color: var(--brand); margin-top: 8rpx; }
.plan-num { font-size: 40rpx; font-weight: 700; }
.plan-unit { font-size: 20rpx; color: var(--muted); margin-top: 4rpx; }

.hint { font-size: 22rpx; color: var(--muted); margin-top: 14rpx; line-height: 1.5; }

.rules { font-size: 22rpx; color: var(--muted); text-align: center; line-height: 1.6; padding: 0 24rpx; }
