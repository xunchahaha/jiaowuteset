/* Shared by personal and classroom timetables. 110rpx rows match lesson positioning in JS. */
.page { height: 100vh; background: var(--canvas); display: flex; flex-direction: column; overflow: hidden; }
.hero { flex-shrink: 0; padding: 28rpx 28rpx 12rpx; color: var(--ink); }
.hero-title { font-size: 36rpx; font-weight: 600; line-height: 1.4; word-break: break-all; }
.toolbar { flex-shrink: 0; padding: 20rpx 18rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; background: var(--canvas); }
.nav-btn { flex-shrink: 0; width: 112rpx; height: 72rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--surface); color: var(--brand); font-size: 25rpx; font-weight: 500; line-height: 72rpx; text-align: center; box-sizing: border-box; }
.nav-btn:active { background: #edf3fa; }
.week, .toolbar-week { color: var(--ink); font-size: 27rpx; font-weight: 600; flex: 1; min-width: 0; text-align: center; line-height: 1.5; }
.cache-banner { flex-shrink: 0; margin: 0 16rpx 16rpx; }
.status { flex-shrink: 0; text-align: center; padding: 32rpx; font-size: 26rpx; color: var(--muted); }
.status.error { color: #b84c4c; }
.grid { flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--surface); margin: 0 12rpx 16rpx; margin-bottom: calc(16rpx + env(safe-area-inset-bottom)); border: 1rpx solid var(--line); border-radius: 14rpx; overflow: hidden; }
.header-row { flex-shrink: 0; display: flex; background: #f0f4f8; border-bottom: 1rpx solid var(--line); }
.time-header { width: 60rpx; min-width: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: var(--muted); border-right: 1rpx solid var(--line); }
.day-header { flex: 1; min-width: 0; padding: 16rpx 0; text-align: center; color: var(--ink); border-right: 1rpx solid var(--line); }
.day-header:last-child { border-right: none; }
.day-name { font-size: 22rpx; font-weight: 600; }
.day-date { margin-top: 4rpx; font-size: 20rpx; color: var(--muted); }
.grid-body { flex: 1; min-height: 0; display: flex; position: relative; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.time-column { width: 60rpx; min-width: 60rpx; border-right: 1rpx solid var(--line); background: #fcfdfe; }
.time-slot { height: 110rpx; padding: 0 4rpx; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 18rpx; color: var(--muted); line-height: 1.3; border-bottom: 1rpx solid var(--line); white-space: pre-wrap; box-sizing: border-box; }
.days-columns { flex: 1; min-width: 0; display: flex; position: relative; }
.day-column { flex: 1; width: 0; position: relative; border-right: 1rpx solid var(--line); }
.day-column:last-child { border-right: none; }
.slot-line { height: 110rpx; border-bottom: 1rpx solid var(--line); box-sizing: border-box; }
.lesson-block { position: absolute; left: 2rpx; right: 2rpx; top: 0; padding: 8rpx 4rpx; border-radius: 6rpx; border-top: 3rpx solid #7195bd; box-sizing: border-box; overflow: hidden; background: #eaf1f9; color: #365a80; display: flex; flex-direction: column; justify-content: center; text-align: center; z-index: 10; }
.lesson-block:active { opacity: 0.75; }
.lesson-name { font-size: 20rpx; font-weight: 600; line-height: 1.25; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
.lesson-meta { margin-top: 4rpx; font-size: 18rpx; line-height: 1.25; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.lesson-teacher { display: none; }
.lesson-roomy .lesson-teacher { display: block; max-width: 100%; margin-top: 4rpx; font-size: 18rpx; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lesson-block.color-1 { background: #f7eee6; color: #845c3c; border-top-color: #c7a181; }
.lesson-block.color-2 { background: #edf3e8; color: #516d3c; border-top-color: #98b17e; }
.lesson-block.color-3 { background: #eaf1f9; color: #365a80; border-top-color: #7195bd; }
.lesson-block.color-4 { background: #f1edf7; color: #685181; border-top-color: #a592bd; }
.lesson-block.color-5 { background: #f8f3e3; color: #7f6a2b; border-top-color: #c5b36d; }
.lesson-block.color-6 { background: #e7f2ef; color: #396e61; border-top-color: #7eafa1; }
.lesson-block.color-7 { background: #f7ecef; color: #865568; border-top-color: #c298a8; }
.lesson-block.color-8 { background: #edf0f8; color: #515e88; border-top-color: #929fc3; }
.extra { padding: 20rpx; background: var(--surface); border-top: 1rpx solid var(--line); flex-shrink: 0; max-height: 200rpx; overflow-y: auto; }
.extra-title { font-size: 26rpx; font-weight: 600; color: var(--ink); margin-bottom: 12rpx; }
.extra-list { display: block; overflow: hidden; border-radius: 12rpx; }
