<view class="page">
  <view class="login-brand">
    <image class="login-logo" src="/assets/brand.png" mode="aspectFit" />
    <view class="brand-caption">校园日常 · 有序相伴</view>
  </view>
  <view class="card">
    <view class="title">欢迎回到教务助手</view>
    <view class="login-subtitle">登录教务账号，开启你的校园日常。</view>
    <view wx:if="{{rememberedAccounts.length}}" class="saved-accounts">
      <view class="saved-title">已保存账号</view>
      <scroll-view scroll-x class="saved-scroll" enable-flex="true">
        <block wx:for="{{rememberedAccounts}}" wx:key="username">
          <t-tag class="saved-tag" theme="{{item.username === username ? 'primary' : 'default'}}" variant="{{item.username === username ? 'light' : 'outline'}}" shape="round" size="large" bind:click="onSelectRememberedAccount" data-username="{{item.username}}">
            {{item.username}}
          </t-tag>
        </block>
      </scroll-view>
    </view>
    <t-input class="form-input" placeholder="学号/工号" value="{{username}}" clearable prefix-icon="user" bind:change="onUsernameInput" />
    <view class="password-box">
      <t-icon class="password-icon" name="lock-on" size="44rpx" />
      <input class="password-native-input" placeholder="密码" password="{{!showPassword}}" value="{{password}}" bindinput="onPasswordInput" />
      <view wx:if="{{password}}" class="password-clear" bindtap="clearPassword">×</view>
      <view class="password-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</view>
    </view>
    <view class="options">
      <t-switch value="{{remember}}" bind:change="onRememberChange" />
      <text class="option-text">记住密码</text>
    </view>
    <t-button block size="large" theme="primary" loading="{{loading}}" disabled="{{loading}}" bind:tap="onLogin">登录</t-button>
    <view class="tip">仅在自己的设备上记住密码；已保存账号可点选切换。</view>

    <view class="new-student-divider">
      <view class="divider-line"></view>
      <text class="divider-text">更多服务</text>
      <view class="divider-line"></view>
    </view>

    <view class="admission-entry" bindtap="goStudy" aria-role="button" aria-label="刷课服务">
      <view class="admission-entry-icon"><t-icon name="{{studyLocked ? 'lock-on' : 'play-circle'}}" size="40rpx" /></view>
      <view class="admission-entry-copy">
        <view class="admission-entry-title">刷课服务<text class="entry-badge">{{studyLocked ? '维护中' : '新'}}</text></view>
        <view class="admission-entry-desc">{{studyLocked ? '暂停接单，剩余次数可联系退款' : '无需教务账号，用学习通账号即可刷课'}}</view>
      </view>
      <t-icon name="chevron-right" size="36rpx" color="#376da6" />
    </view>
  </view>
</view>
