.page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 56rpx 40rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--canvas); }
.login-brand { text-align: center; margin-bottom: 44rpx; }
.login-logo { width: 148rpx; height: 148rpx; border-radius: 32rpx; display: block; margin: 0 auto 18rpx; }
.brand-caption { font-size: 23rpx; color: var(--muted); letter-spacing: 2rpx; }
.card { width: 100%; max-width: 670rpx; box-sizing: border-box; background: var(--surface); padding: 40rpx 32rpx 28rpx; border: 1rpx solid var(--line); border-radius: 20rpx; }
.title { color: var(--ink); font-size: 39rpx; font-weight: 600; line-height: 1.4; }
.login-subtitle { margin: 12rpx 0 36rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.saved-accounts { margin-bottom: 26rpx; }
.saved-title { font-size: 23rpx; color: var(--muted); margin-bottom: 14rpx; }
.saved-scroll { white-space: nowrap; }
.saved-tag { margin-right: 14rpx; }
.form-input { display: block; width: 100%; min-height: 96rpx; border: 1rpx solid var(--line); border-radius: 12rpx; margin-bottom: 20rpx; background: var(--canvas); box-sizing: border-box; overflow: hidden; --td-input-border-color: transparent; --td-input-vertical-padding: 24rpx; }
.password-box { width: 100%; min-height: 96rpx; margin-bottom: 24rpx; padding: 0 18rpx 0 24rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--canvas); box-sizing: border-box; display: flex; align-items: center; }
.password-icon { flex-shrink: 0; color: var(--muted); margin-right: 20rpx; }
.password-native-input { flex: 1; min-width: 0; height: 92rpx; font-size: 30rpx; color: var(--ink); line-height: 92rpx; }
.password-clear { flex-shrink: 0; width: 56rpx; height: 72rpx; color: var(--muted); font-size: 34rpx; line-height: 72rpx; text-align: center; }
.password-toggle { flex-shrink: 0; margin-left: 12rpx; min-width: 68rpx; padding: 20rpx 0; color: var(--brand); font-size: 25rpx; text-align: center; }
.options { display: flex; align-items: center; margin-bottom: 30rpx; }
.option-text { margin-left: 16rpx; font-size: 25rpx; color: #536478; }
.tip { margin-top: 20rpx; font-size: 22rpx; color: var(--muted); line-height: 1.7; }
.new-student-divider { display: flex; align-items: center; margin: 32rpx 0 22rpx; }
.divider-line { flex: 1; height: 1rpx; background: var(--line); }
.divider-text { padding: 0 18rpx; color: var(--muted); font-size: 22rpx; }
.admission-entry { display: flex; align-items: center; box-sizing: border-box; width: 100%; padding: 16rpx 0; border-radius: 12rpx; }
.admission-entry:active { background: var(--canvas); }
.admission-entry-icon { flex-shrink: 0; width: 60rpx; height: 60rpx; margin-right: 16rpx; color: var(--brand); display: flex; align-items: center; justify-content: center; }
.admission-entry-copy { flex: 1; min-width: 0; }
.admission-entry-title { margin-bottom: 6rpx; color: var(--ink); font-size: 27rpx; font-weight: 500; }
.admission-entry-desc { color: var(--muted); font-size: 22rpx; line-height: 1.5; }

.entry-badge { margin-left: 10rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: var(--td-brand-color-light); color: var(--brand); font-size: 20rpx; font-weight: 400; }
