.page {
  min-height: 100vh;
  background: var(--canvas);
  padding-bottom: 24rpx;
}

.hero {
  padding: 32rpx 28rpx 12rpx;
  background: var(--canvas);
}

.course-name {
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.card,
.students-card,
.list-card {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: none;
  border: 1rpx solid var(--line);
}

.card {
  display: block;
  overflow: hidden;
}

.students-card {
  display: block;
  overflow: hidden;
}

.status {
  margin: 16rpx 24rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
}

.status.error {
  color: #f56c6c;
}

.list-card {
  display: block;
  overflow: hidden;
}

.cache-banner {
  margin: 20rpx 32rpx 0;
}

.exam-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.tag-exam { color: #b24631; background: #fbece8; }
.tag-check { color: #24774f; background: #e7f4ed; }
.tag-other { color: #8a6116; background: #fbf2df; }
.tag-elective { color: #5c6c80; background: #eef1f5; }

.arrange-lines {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #536478;
}
