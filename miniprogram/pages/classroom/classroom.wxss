.page {
  height: 100vh;
  background: var(--canvas);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.hero {
  flex-shrink: 0;
  padding: 28rpx 28rpx 24rpx;
  color: var(--ink);
  background: var(--canvas);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.92;
  line-height: 1.6;
  color: var(--muted);
}

.filter-card {
  flex-shrink: 0;
  margin: 0 24rpx 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: none;
  border: 1rpx solid var(--line);
}

.field {
  margin-bottom: 20rpx;
}

.field:last-of-type {
  margin-bottom: 0;
}

.field-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}

.keyword-input {
  border-radius: 16rpx;
  background: #f8fafc;
  width: 100%;
}

.free-room-panel {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eef2f7;
}

.free-room-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.free-room-controls {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.free-room-picker {
  flex: 1;
  min-width: 0;
  padding: 16rpx 10rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.picker-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.picker-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.free-room-btn {
  border-radius: 14rpx;
}

.free-room-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.selected-room {
  font-size: 23rpx;
  color: #475569;
}

.state-card {
  margin: 0 24rpx 20rpx;
  padding: 40rpx 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
}

.error-text {
  color: #cf1322;
}

.candidate-list {
  display: block;
  overflow: hidden;
  border-radius: 16rpx;
}

.candidate-card {
  flex: 1;
  min-height: 0;
  margin: 0 24rpx 20rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: none;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
}

.candidate-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 14rpx;
}

.free-room-summary {
  margin-bottom: 14rpx;
  font-size: 23rpx;
  color: var(--brand);
  line-height: 1.5;
}

.candidate-item {
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.candidate-item:last-child {
  border-bottom: none;
}

.candidate-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
}

.candidate-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}

.candidate-more {
  padding: 18rpx 0 4rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}

.result-list {
  height: calc(100vh - 460rpx);
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}
