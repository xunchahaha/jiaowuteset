.admission-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: var(--canvas);
}

.hero {
  display: flex;
  align-items: center;
  padding: 12rpx 0 24rpx;
  border-radius: 24rpx;
  background: transparent;
  color: var(--ink);
  box-shadow: none;
}

.hero-icon {
  width: 84rpx;
  height: 84rpx;
  margin-right: 24rpx;
  border-radius: 22rpx;
  background: #edf3fa;
  font-size: 40rpx;
  line-height: 84rpx;
  text-align: center;
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  margin-bottom: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  color: var(--muted);
  line-height: 1.6;
}

.query-card,
.result-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: none;
  border: 1rpx solid var(--line);
  border-left: 3rpx solid #397560;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: #fafbfc;
  font-size: 29rpx;
  color: var(--ink);
}

.field-input:focus {
  border-color: var(--brand);
}

.query-button {
  height: 88rpx;
  margin-top: 8rpx;
  border-radius: 16rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.query-button::after {
  border: none;
}

.query-button[disabled] {
  background: #a6bdd6;
  color: rgba(255, 255, 255, 0.9);
}

.result-card {
  border-left: 3rpx solid #397560;
}

.result-card.empty {
  border-left-color: #faad14;
}

.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.result-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: var(--brand);
}

.empty .result-dot {
  background: #faad14;
}

.result-title {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--ink);
}

.result-text {
  white-space: pre-wrap;
  font-size: 27rpx;
  line-height: 1.8;
  color: #5b667a;
}

.success .result-text {
  color: #277a0a;
}

.result-fields {
  margin-top: 24rpx;
  border-top: 2rpx solid #edf0f4;
}

.result-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 82rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #edf0f4;
  box-sizing: border-box;
}

.result-label {
  flex-shrink: 0;
  width: 170rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.result-value {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.source-note {
  padding: 28rpx 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: #9aa3b2;
}
