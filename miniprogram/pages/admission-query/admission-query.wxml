<view class="admission-page">
  <view class="hero">
    <view class="hero-icon"><t-icon name="education" size="44rpx" /></view>
    <view class="hero-copy">
      <view class="hero-title">录取查询</view>
      <view class="hero-subtitle">天津中德应用技术大学招生信息网</view>
    </view>
  </view>

  <view class="query-card">
    <view class="field">
      <view class="field-label">考生姓名</view>
      <input
        class="field-input"
        value="{{name}}"
        maxlength="30"
        placeholder="请输入考生姓名"
        bindinput="onNameInput"
      />
    </view>

    <view class="field">
      <view class="field-label">考生号</view>
      <input
        class="field-input"
        value="{{candidateNumber}}"
        maxlength="30"
        placeholder="请输入考生号"
        bindinput="onCandidateNumberInput"
        confirm-type="search"
        bindconfirm="submitQuery"
      />
    </view>

    <button
      class="query-button"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="submitQuery"
    >{{loading ? '查询中' : '开始查询'}}</button>
  </view>

  <view wx:if="{{resultText}}" class="result-card {{hasRecord ? 'success' : 'empty'}}">
    <view class="result-header">
      <view class="result-dot"></view>
      <view class="result-title">{{hasRecord ? '恭喜录取' : '暂无录取信息'}}</view>
    </view>
    <view class="result-text">{{resultText}}</view>
    <view wx:if="{{hasRecord}}" class="result-fields">
      <view wx:for="{{resultFields}}" wx:key="label" class="result-row">
        <text class="result-label">{{item.label}}</text>
        <text class="result-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <view class="source-note">
    数据来源：天津中德应用技术大学招生信息网
  </view>
</view>
