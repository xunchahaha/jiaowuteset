.page {
  min-height: 100vh;
  background: var(--canvas);
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: none;
}

.hero-title {
  font-size: 36rpx;
  line-height: 1.5;
  color: var(--ink);
  font-weight: 600;
}

.hero-course {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background: #edf3fa;
  color: var(--brand);
  font-size: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #4e5969;
  font-weight: 600;
  margin: 0 8rpx 16rpx;
}

.info-card,
.state-card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: none;
  overflow: hidden;
  border: 1rpx solid var(--line);
}

.state-card {
  padding: 36rpx 28rpx;
  padding-top: 36rpx;
  padding-bottom: 36rpx;
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
}

.error-card {
  color: #d93026;
}

.cache-banner {
  margin: 20rpx 32rpx 0;
}
