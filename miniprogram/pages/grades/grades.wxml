<view class="page">
  <view class="page-intro"><view class="page-intro-title">我的成绩</view><view class="page-intro-desc">每一份努力，都有迹可循。</view></view>
  <view class="summary">
    <view class="summary-item">
      <view class="summary-value">{{totalGp}}</view>
      <view class="summary-label">平均学分绩点</view>
    </view>
    <view class="summary-item">
      <view class="summary-value">{{totalCredits}}</view>
      <view class="summary-label">总学分</view>
    </view>
  </view>

  <view wx:if="{{bizTypeOptions.length > 1}}" class="biz-switch">
    <picker mode="selector" range="{{bizTypeLabels}}" value="{{bizTypeIndex}}" bindchange="onBizTypeChange">
      <view class="biz-picker">
        <view class="biz-copy">
          <view class="biz-label">当前成绩类型</view>
          <view class="biz-value">{{bizTypeLabel}}</view>
        </view>
        <t-icon name="chevron-down" size="30rpx" />
      </view>
    </picker>
  </view>

  <t-notice-bar wx:if="{{showCacheBanner}}" class="cache-banner" theme="warning" content="{{cacheNotice}}" />
  <view wx:if="{{loading}}" class="state-panel">
    <t-loading loading theme="circular" size="48rpx" text="加载中..." />
  </view>
  <view wx:if="{{!loading && error}}" class="state-panel">
    <t-empty icon="error-circle" description="{{error}}" />
  </view>
  <view wx:if="{{!loading && !error && semesters.length === 0}}" class="state-panel">
    <t-empty description="暂无成绩" />
  </view>

  <block wx:for="{{semesters}}" wx:for-item="semester" wx:for-index="sIndex" wx:key="id">
    <view class="semester-title">{{semester.text}}</view>
    <t-cell-group class="lesson-group">
      <block wx:for="{{semester.lessons}}" wx:for-item="lesson" wx:for-index="lIndex" wx:key="id">
        <t-cell title="{{lesson.courseName}}" description="{{lesson.courseCode ? lesson.courseCode + '  ' : ''}}学分：{{lesson.courseCredit}}  绩点：{{lesson.courseGp}}" arrow bordered bind:click="toggleLesson" data-sindex="{{sIndex}}" data-lindex="{{lIndex}}">
          <view slot="note" class="score-note">
            <t-tag theme="{{lesson.passed ? 'success' : 'danger'}}" variant="light" shape="round" size="large">{{lesson.scoreText}}</t-tag>
          </view>
        </t-cell>
        <view wx:if="{{lesson.expanded && lesson.examGrades.length}}" class="exam-grades">
          <block wx:for="{{lesson.examGrades}}" wx:for-item="exam" wx:key="type">
            <view class="exam-grade">
              <text class="exam-type">{{exam.type || '成绩明细'}}</text>
              <text class="{{exam.passed ? '' : 'red'}}">{{exam.scoreText || '-'}}</text>
            </view>
          </block>
        </view>
      </block>
    </t-cell-group>
  </block>
</view>
