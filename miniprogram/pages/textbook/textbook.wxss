/* pages/textbook/textbook.wxss */
.page {
  min-height: 100vh;
  background: var(--canvas);
  padding-bottom: 40rpx;
}

.header {
  background: #ffffff;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.header-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--muted);
}

.cache-banner {
  margin: 20rpx 24rpx 0;
}

.filter-section {
  position: relative;
  width: 100%;
}

.semester-picker {
  flex-shrink: 0;
  width: 100%;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: var(--canvas);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
}

.semester-picker-text {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.semester-picker-icon {
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* 自定义下拉菜单样式 */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 998;
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 32rpx;
  right: 32rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: none;
  z-index: 999;
  margin-top: 8rpx;
  max-height: 600rpx;
  overflow: hidden;
}

.dropdown-scroll {
  max-height: 600rpx;
}

.dropdown-item {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.2s;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item.active {
  background: #f0f9ff;
  color: var(--brand);
  font-weight: 600;
}

.dropdown-item:active {
  background: #f5f5f5;
}

.content {
  padding: 0 24rpx;
}

.loading-state, .error-state, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: var(--muted);
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 24rpx;
}

.textbook-list {
  padding-bottom: 20rpx;
  padding-top: 24rpx;
}

.textbook-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: none;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid var(--line);
}

.textbook-main {
  flex: 1;
  min-width: 0;
}

.textbook-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.textbook-detail-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.textbook-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.textbook-course {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.course-name {
  margin-right: 12rpx;
  margin-left: 12rpx;
}

.textbook-row {
  display: flex;
  font-size: 26rpx;
  line-height: 1.5;
}

.textbook-row .label {
  color: var(--muted);
  width: 100rpx;
  flex-shrink: 0;
}

.textbook-row .value {
  color: #4e5969;
  flex: 1;
}

.textbook-row .value.isbn {
  font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
  color: #666;
}
