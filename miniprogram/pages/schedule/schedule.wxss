@import "../../styles/timetable.wxss";

.grid { margin-bottom: 0; }
.schedule-actions { flex-shrink: 0; display: flex; justify-content: space-between; padding: 2rpx 18rpx calc(2rpx + env(safe-area-inset-bottom)); }
.schedule-actions .schedule-more { display: block; width: auto; min-width: 96rpx; height: 60rpx; min-height: 0; margin: 0; padding: 0 12rpx; line-height: 60rpx; font-size: 23rpx; font-weight: 400; color: var(--muted); background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.schedule-more::after { border: 0; }
